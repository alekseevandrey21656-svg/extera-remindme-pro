import threading
import time
from concurrent.futures import Future
from datetime import datetime, timedelta
from typing import Any, Dict, List, Optional, Tuple

from android_utils import log, run_on_ui_thread
from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from client_utils import get_last_fragment, get_user_config, run_on_queue, send_message
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Selector, Switch, Text

__id__ = "remind_pro"
__name__ = "RemindMe Pro"
__description__ = "Умный календарь и менеджер напоминаний с поддержкой парсинга времени"
__author__ = "@Qwexieee @QwePlugins"
__version__ = "2.0.0"
__icon__ = "remind_pro/1"
__min_version__ = "12.1.1"

DEFAULT_PREFIX = ".remind"
DEFAULT_ENABLE_REMINDERS = True
DEFAULT_REMIND_TO_SELF = True
DEFAULT_TIME_STR = "09:00"
DEFAULT_WEEK_START = 0
DEFAULT_CONFIRM_AS_BULLETIN = True
DEFAULT_MENU_ON_PREFIX = True
DEFAULT_MENU_CHAT = True
DEFAULT_MENU_DRAWER = False

_MONTH_NAMES_RU = [
    "", "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
    "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь",
]

Event = Dict[str, Any]

# Импортируем R один раз на уровне модуля
try:
    from org.telegram.messenger import R as _R_TG
    _ICON_SUCCESS = getattr(_R_TG.raw, "success", getattr(_R_TG.raw, "check", _R_TG.raw.info))
    _ICON_DELETE = getattr(_R_TG.raw, "delete", _R_TG.raw.info)
    _ICON_INFO = _R_TG.raw.info
except Exception:
    _ICON_SUCCESS = _ICON_DELETE = _ICON_INFO = None


class RemindMePlugin(BasePlugin):

    def on_plugin_load(self):
        self._lock = threading.RLock()
        self._events_cache: Optional[List[Event]] = None
        self._cache_dirty = False
        self._storage_broken = False

        if self.get_setting("next_id", None) is None:
            self.set_setting("next_id", 1)
        if self.get_setting("events_json", None) is None:
            self._persist([])

        self._load_events()  # прогрев кэша

        self._ui_state = {
            "year": datetime.now().year,
            "month": datetime.now().month,
        }
        self._menu_items_registered = False
        self._register_menu_items()
        self.add_on_send_message_hook()
        log("RemindMe Pro loaded")

    # ------------------------------------------------------------------ #
    # Settings                                                             #
    # ------------------------------------------------------------------ #

    def create_settings(self):
        def on_prefix_change(val: str):
            v = val.strip()
            if not v:
                return
            if not v.startswith("."):
                v = "." + v
            v = v.rstrip(".")   # только хвостовые точки, ведущая сохраняется
            if len(v) > 1:      # одна точка — не префикс
                self.set_setting("prefix", v)

        def _reload_menu(val: bool, key: str):
            self.set_setting(key, val)
            self._register_menu_items()
            BulletinHelper.show_success("Меню обновлено")

        return [
            Header(text="Основные настройки"),
            Input(
                key="prefix",
                text="Префикс команды",
                default=self.get_setting("prefix", DEFAULT_PREFIX),
                subtext="Например: .remind или .напомни",
                icon="msg_mention",
                on_change=on_prefix_change,
            ),
            Switch(
                key="menu_on_prefix",
                text="Окно по префиксу",
                default=self.get_setting("menu_on_prefix", DEFAULT_MENU_ON_PREFIX),
                subtext="Открыть меню при вводе только префикса",
                icon="msg_menu",
            ),
            Switch(
                key="menu_chat",
                text="Пункт в меню чата",
                default=self.get_setting("menu_chat", DEFAULT_MENU_CHAT),
                subtext="Три точки → Plugins → Напоминания",
                icon="msg_calendar",
                on_change=lambda v: _reload_menu(v, "menu_chat"),
            ),
            Switch(
                key="menu_drawer",
                text="Пункт в боковом меню",
                default=self.get_setting("menu_drawer", DEFAULT_MENU_DRAWER),
                subtext="Главное меню приложения",
                icon="msg_list",
                on_change=lambda v: _reload_menu(v, "menu_drawer"),
            ),
            Switch(
                key="enable_reminders",
                text="Автонастройка напоминаний",
                default=self.get_setting("enable_reminders", DEFAULT_ENABLE_REMINDERS),
                subtext="Создавать отложенное сообщение при добавлении",
                icon="msg_reminders",
            ),
            Switch(
                key="remind_to_self",
                text="Отправлять в Избранное",
                default=self.get_setting("remind_to_self", DEFAULT_REMIND_TO_SELF),
                subtext="Если выключено — шлёт в текущий чат",
                icon="msg_saved",
            ),
            Input(
                key="default_time",
                text="Время по умолчанию (HH:MM)",
                default=self.get_setting("default_time", DEFAULT_TIME_STR),
                icon="msg_time",
            ),
            Selector(
                key="week_start",
                text="Начало недели",
                default=self.get_setting("week_start", DEFAULT_WEEK_START),
                items=["Пн", "Вс"],
                icon="msg_calendar",
            ),
            Switch(
                key="confirm_as_bulletin",
                text="Уведомления как плашки",
                default=self.get_setting("confirm_as_bulletin", DEFAULT_CONFIRM_AS_BULLETIN),
                subtext="Всплывающие подсказки с кнопкой OK",
                icon="msg_info",
            ),
            Divider(text="Быстрый ввод"),
            Text(
                text=(
                    "Примеры умных команд:\n"
                    ".remind через 15м Чай\n"
                    ".remind завтра в 14:00 Встреча\n"
                    ".remind сегодня в 18:30 Позвонить\n"
                    ".remind 2026-09-01 Учёба\n"
                    ".remind 2026-09-01 9:00 Учёба"
                ),
            ),
        ]

    # ------------------------------------------------------------------ #
    # Menu                                                                 #
    # ------------------------------------------------------------------ #

    def _register_menu_items(self):
        if self._menu_items_registered:
            cleared = False
            for method_name in ("clear_menu_items", "remove_menu_items", "clear_menu"):
                clear_fn = getattr(self, method_name, None)
                if callable(clear_fn):
                    try:
                        clear_fn()
                        cleared = True
                        break
                    except Exception as e:
                        log(f"_register_menu_items: {method_name}() error: {e}")
            if not cleared:
                # Ни один метод очистки не доступен.
                # Повторная регистрация создаст дубли — не делаем этого.
                # Свитчи меню подействуют после перезапуска плагина.
                log("_register_menu_items: no clear API found, skipping re-register")
                return

        try:
            if self.get_setting("menu_chat", DEFAULT_MENU_CHAT):
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Напоминания",
                    icon="msg_calendar",
                    on_click=lambda ctx: self._open_root_menu(ctx.get("dialog_id")),
                ))
            if self.get_setting("menu_drawer", DEFAULT_MENU_DRAWER):
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="Напоминания",
                    icon="msg_calendar",
                    on_click=lambda _ctx: self._open_root_menu(None),
                ))
            self._menu_items_registered = True
        except Exception as e:
            log(f"_register_menu_items error: {e}")

    # ------------------------------------------------------------------ #
    # Hook                                                                 #
    # ------------------------------------------------------------------ #

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        msg = params.message if isinstance(params.message, str) else ""
        prefix = self.get_setting("prefix", DEFAULT_PREFIX)

        if not msg.startswith(prefix):
            return HookResult(strategy=HookStrategy.CONTINUE)

        peer = getattr(params, "peer", None)

        if msg.strip() == prefix:
            if self.get_setting("menu_on_prefix", DEFAULT_MENU_ON_PREFIX):
                run_on_ui_thread(lambda: self._open_root_menu(peer))
            return HookResult(strategy=HookStrategy.CANCEL)

        run_on_queue(lambda: self._handle_command(msg, prefix, peer))
        return HookResult(strategy=HookStrategy.CANCEL)

    def _handle_command(self, msg: str, prefix: str, peer: Any):
        body = msg[len(prefix):].strip()
        parts = body.split(None, 1)
        cmd = parts[0].lower() if parts else ""
        rest = parts[1] if len(parts) > 1 else ""

        try:
            if cmd == "help":
                self._reply(peer, self._help_text())

            elif cmd == "add":
                event, warn = self._cmd_add(rest, peer)
                self._notify_event_created(event, warn, peer=peer)

            elif cmd == "list":
                if rest:
                    try:
                        count = int(rest.split()[0])
                    except ValueError:
                        p = self.get_setting("prefix", DEFAULT_PREFIX)
                        self._bulletin(f"Укажите число: {p} list 5", "info", peer=peer)
                        return
                else:
                    count = 5
                self._reply(peer, self._fmt_list(self._get_upcoming(count)))

            elif cmd == "del":
                if not rest:
                    self._bulletin("Укажите ID: .remind del ID", "info", peer=peer)
                    return
                try:
                    eid = int(rest.split()[0])
                except ValueError:
                    self._bulletin("ID должен быть числом", "info", peer=peer)
                    return
                ok = self._delete_event(eid)
                msg_text = "Событие удалено" if ok else "Событие не найдено"
                self._bulletin(msg_text, "delete" if ok else "info", peer=peer)

            elif cmd == "clear":
                with self._lock:
                    self._replace_cache([])
                    self._flush()
                self._bulletin("Все события очищены", "delete", peer=peer)

            elif cmd == "month":
                try:
                    y, m = self._parse_ym(rest)
                    self._reply(peer, self._render_month(y, m))
                except ValueError as e:
                    self._bulletin(str(e), "info", peer=peer)

            elif cmd == "next":
                ev = self._next_event()
                self._reply(peer, self._fmt_event(ev) if ev else "Ближайших событий нет")

            else:
                # Дата без текста — подсказываем формат.
                _date_only = re.fullmatch(r"\d{4}-\d{2}-\d{2}", body.strip())
                _date_time_only = re.fullmatch(
                    r"\d{4}-\d{2}-\d{2}\s+\d{1,2}:\d{2}", body.strip()
                )
                if _date_only or _date_time_only:
                    p = self.get_setting("prefix", DEFAULT_PREFIX)
                    self._bulletin(
                        f"Укажите текст события:\n{p} add YYYY-MM-DD [H:MM] Текст",
                        "info", peer=peer,
                    )
                    return
                event, warn = self._parse_smart(body, peer)
                if event:
                    self._notify_event_created(event, warn, peer=peer)
                else:
                    self._bulletin("Неизвестная команда. Справка: .remind help", "info", peer=peer)

        except Exception as e:
            log(f"_handle_command error: {e}")
            self._bulletin(f"Ошибка: {e}", "info", peer=peer)

    # ------------------------------------------------------------------ #
    # Storage / cache                                                      #
    # ------------------------------------------------------------------ #

    @staticmethod
    def _try_parse(raw: str) -> List[Event]:
        raw_list = json.loads(raw)
        good, bad = [], []
        for e in raw_list:
            try:
                e["ts"] = int(e["ts"])
                e["id"] = int(e["id"])
                good.append(e)
            except Exception:
                bad.append(e)
        if bad:
            log(f"_load_events: skipped {len(bad)} malformed entries")
        good.sort(key=lambda e: e["ts"])
        return good

    def _load_events(self) -> List[Event]:
        """Возвращает кэш. Читает с диска только один раз."""
        with self._lock:
            if self._events_cache is not None:
                return self._events_cache

            # 1. Пробуем основной ключ
            primary = self.get_setting("events_json", "[]")
            try:
                self._events_cache = self._try_parse(primary)
                return self._events_cache
            except Exception as e:
                log(f"_load_events: primary parse error: {e}")

            # 2. Пробуем резервный ключ (записывается _persist при broken)
            fallback = self.get_setting("events_json_v2", None)
            if fallback:
                try:
                    self._events_cache = self._try_parse(fallback)
                    self._storage_broken = False  # v2 валиден — пишем туда и дальше
                    log("_load_events: recovered from events_json_v2")
                    return self._events_cache
                except Exception as e:
                    log(f"_load_events: fallback parse error: {e}")

            # 3. Оба битые — помечаем broken, сохраняем оригинал
            try:
                self.set_setting("events_json_corrupt", primary)
            except Exception:
                pass
            self._events_cache = []
            self._cache_dirty = False
            self._storage_broken = True

            def _notify():
                try:
                    BulletinHelper.show_error(
                        "⚠️ Хранилище напоминаний повреждено. "
                        "Оригинал сохранён в events_json_corrupt. "
                        "Новые события сохраняются в events_json_v2."
                    )
                except Exception as ex:
                    log(f"_load_events notify error: {ex}")

            run_on_queue(lambda: run_on_ui_thread(_notify))
            return self._events_cache

    def _replace_cache(self, events: List[Event]):
        # Вызывается только внутри блоков with self._lock
        self._events_cache = events
        self._cache_dirty = True

    def _persist(self, events: List[Event]):
        data = json.dumps(events, ensure_ascii=False)
        if self._storage_broken:
            # Оригинал повреждён — пишем в резервный ключ, не теряем новые события
            try:
                self.set_setting("events_json_v2", data)
            except Exception as e:
                log(f"_persist fallback error: {e}")
            return
        self.set_setting("events_json", data)
        self._cache_dirty = False

    def _flush(self):
        # Вызывается только внутри блоков with self._lock
        if self._cache_dirty and self._events_cache is not None:
            self._persist(self._events_cache)

    def _mutate_and_flush(self, events: List[Event]):
        # Вызывается только внутри блоков with self._lock
        events.sort(key=lambda e: e["ts"])
        self._replace_cache(events)
        self._flush()

    def _next_id(self) -> int:
        # Вызывается внутри with self._lock
        nid = int(self.get_setting("next_id", 1))
        self.set_setting("next_id", nid + 1)
        return nid

    def _add_event(self, dt: datetime, title: str) -> Event:
        with self._lock:
            events = list(self._load_events())
            ev: Event = {
                "id": self._next_id(),
                "ts": int(dt.timestamp()),
                "title": title,
                "created_at": int(time.time()),
            }
            events.append(ev)
            self._mutate_and_flush(events)
        return ev

    def _delete_event(self, eid: int) -> bool:
        with self._lock:
            events = self._load_events()
            new_events = [e for e in events if int(e.get("id", -1)) != eid]
            if len(new_events) == len(events):
                return False
            self._mutate_and_flush(new_events)
        return True

    def _get_upcoming(self, n: int) -> List[Event]:
        with self._lock:
            events = list(self._load_events())
            now_ts = int(time.time())
            upcoming = [e for e in events if int(e.get("ts", 0)) >= now_ts]
            return upcoming[:max(0, n)]

    def _next_event(self) -> Optional[Event]:
        ups = self._get_upcoming(1)
        return ups[0] if ups else None

    # ------------------------------------------------------------------ #
    # Scheduling                                                           #
    # ------------------------------------------------------------------ #

    def _get_self_peer(self) -> Optional[int]:
        try:
            uc = get_user_config()
            if hasattr(uc, "getClientUserId"):
                uid = int(uc.getClientUserId())
                return uid if uid != 0 else None
            user = uc.getCurrentUser()
            if not user:
                return None
            uid = getattr(user, "id", None)
            if uid is None:
                get_id = getattr(user, "getId", None)
                uid = get_id() if callable(get_id) else None
            if uid is None:
                return None
            uid = int(uid)
            return uid if uid != 0 else None
        except Exception as e:
            log(f"_get_self_peer error: {e}")
            return None

    def _schedule_reminder(self, dt: datetime, title: str, peer: Any) -> bool:
        ts = int(dt.timestamp())
        if ts <= int(time.time()) + 5:
            return False
        remind_to_self = self.get_setting("remind_to_self", DEFAULT_REMIND_TO_SELF)
        target_peer = self._get_self_peer() if remind_to_self else peer
        if target_peer is None:
            return False

        msg_text = f"🔔 Напоминание: {title}\nВремя: {dt.strftime('%Y-%m-%d %H:%M')}"
        fut: Future = Future()

        def _do_send():
            try:
                send_message({
                    "peer": target_peer,
                    "message": msg_text,
                    "scheduleDate": ts,
                })
                if not fut.done():
                    fut.set_result(True)
            except Exception as e:
                log(f"_schedule_reminder send error: {e}")
                if not fut.done():
                    fut.set_result(False)

        # Запускаем в отдельном daemon-потоке, а не через run_on_queue.
        # Причина: _schedule_reminder вызывается из worker run_on_queue;
        # если очередь однопоточная, _do_send никогда не дождётся очереди
        # и fut.result(timeout=5) всегда вернёт TimeoutError (дедлок).
        t = threading.Thread(target=_do_send, daemon=True)
        t.start()

        try:
            result = fut.result(timeout=5.0)
            if result:
                log(f"_schedule_reminder: queued at ts={ts}")
            return result
        except Exception as e:
            log(f"_schedule_reminder future timeout/error: {e}")
            return False

    # ------------------------------------------------------------------ #
    # Parsing                                                              #
    # ------------------------------------------------------------------ #

    _RELATIVE_RE = re.compile(
        r"^через\s+(\d+)\s*(м|мин|ч|час|д|дн|дней)\s+(.+)$",
        re.IGNORECASE,
    )
    _DAY_TIME_RE = re.compile(
        r"^(сегодня|завтра)\s+(?:в\s+)?(\d{1,2}:\d{2})\s+(.+)$",
        re.IGNORECASE,
    )
    _ISO_RE = re.compile(
        r"^(\d{4}-\d{2}-\d{2})(?:\s+(\d{1,2}:\d{2}))?\s+(.+)$",
    )

    def _parse_smart(self, text: str, peer: Any) -> Tuple[Optional[Event], Optional[str]]:
        now = datetime.now()
        dt: Optional[datetime] = None
        title = ""

        m = self._RELATIVE_RE.match(text)
        if m:
            val, unit, title = int(m.group(1)), m.group(2).lower(), m.group(3).strip()
            if unit.startswith("м"):
                dt = now + timedelta(minutes=val)
            elif unit.startswith("ч"):
                dt = now + timedelta(hours=val)
            elif unit.startswith("д"):
                dt = now + timedelta(days=val)

        if dt is None:
            m = self._DAY_TIME_RE.match(text)
            if m:
                day_word, time_str, title = m.group(1).lower(), m.group(2), m.group(3).strip()
                hh, mm = (int(x) for x in time_str.split(":"))
                base = now if day_word == "сегодня" else now + timedelta(days=1)
                dt = datetime(base.year, base.month, base.day, hh, mm)

        # Обрабатываем ISO-формат «2026-09-01 [HH:MM] Текст».
        # ValueError не глушим — пусть всплывает в _handle_command.
        if dt is None:
            m = self._ISO_RE.match(text)
            if m:
                date_str = m.group(1)
                time_str = m.group(2) or self.get_setting("default_time", DEFAULT_TIME_STR)
                title = m.group(3).strip()
                dt = self._parse_datetime(date_str, time_str)

        if dt is None or not title:
            return None, None

        event = self._add_event(dt, title)
        warn = None
        if self.get_setting("enable_reminders", DEFAULT_ENABLE_REMINDERS):
            if not self._schedule_reminder(dt, title, peer):
                warn = "Напоминание не запланировано в Telegram."
        return event, warn

    def _cmd_add(self, rest: str, peer: Any) -> Tuple[Event, Optional[str]]:
        # regex вместо split() — сохраняем пробелы в тексте события
        m = re.match(r"^(\S+)(?:\s+(\d{1,2}:\d{2}))?\s+(.+)$", rest)
        if not m:
            raise ValueError("Формат: .remind add YYYY-MM-DD [HH:MM] Текст")
        date_str = m.group(1)
        time_str = m.group(2) or self.get_setting("default_time", DEFAULT_TIME_STR)
        title = m.group(3).strip()
        if not title:
            raise ValueError("Укажите текст события")
        dt = self._parse_datetime(date_str, time_str)
        event = self._add_event(dt, title)
        warn = None
        if self.get_setting("enable_reminders", DEFAULT_ENABLE_REMINDERS):
            if not self._schedule_reminder(dt, title, peer):
                warn = "Напоминание не запланировано (прошедшее время или ошибка)."
        return event, warn

    @staticmethod
    def _parse_datetime(date_str: str, time_str: str) -> datetime:
        if not re.match(r"^\d{4}-\d{2}-\d{2}$", date_str):
            raise ValueError("Дата должна быть в формате YYYY-MM-DD")
        if not re.match(r"^\d{1,2}:\d{2}$", time_str):
            raise ValueError("Время должно быть в формате H:MM или HH:MM")
        y, mo, d = (int(x) for x in date_str.split("-"))
        hh, mm = (int(x) for x in time_str.split(":"))
        try:
            return datetime(y, mo, d, hh, mm)
        except ValueError as e:
            raise ValueError(f"Некорректная дата/время: {e}") from e

    @staticmethod
    def _parse_ym(s: str) -> Tuple[int, int]:
        s = s.strip()
        if re.fullmatch(r"\d{4}-\d{2}", s):
            y, m = (int(x) for x in s.split("-"))
            if not (1 <= m <= 12):
                raise ValueError(f"Месяц должен быть в диапазоне 01–12, получено: {m}")
            return y, m
        now = datetime.now()
        return now.year, now.month

    # ------------------------------------------------------------------ #
    # Formatting                                                           #
    # ------------------------------------------------------------------ #

    def _fmt_event(self, e: Event) -> str:
        if not e:
            return "Событие не найдено"
        dt = datetime.fromtimestamp(int(e.get("ts", 0)))
        return f"#{e.get('id', '?')} • {dt.strftime('%Y-%m-%d %H:%M')} • {e.get('title', '—')}"

    def _fmt_list(self, events: List[Event]) -> str:
        if not events:
            return "Нет ближайших событий"
        return "Ближайшие события:\n" + "\n".join(self._fmt_event(e) for e in events)

    def _week_start_fw(self) -> int:
        # Selector может вернуть индекс (int/str) или саму строку ("Пн"/"Вс")
        raw = self.get_setting("week_start", DEFAULT_WEEK_START)
        if isinstance(raw, str):
            return 0 if raw.strip().lower() in ("пн", "0") else 6
        try:
            return 0 if int(raw) == 0 else 6
        except (TypeError, ValueError):
            return 0

    def _render_month(self, year: int, month: int) -> str:
        """
        Рисует сетку календаря строго в моноширинном виде.
        Каждая ячейка ровно 2 символа. Сегодня помечается «←» справа
        от строки с указанием числа — ширина строки не меняется,
        столбцы не «едут».
        """
        fw = self._week_start_fw()
        cal = calendar.Calendar(firstweekday=fw)
        weeks = cal.monthdayscalendar(year, month)
        day_names = (
            ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
            if fw == 0
            else ["Вс", "Пн", "Вт", "Ср", "Чт", "Пт", "Сб"]
        )
        today = datetime.today()
        is_today_month = today.year == year and today.month == month

        header = f"{_MONTH_NAMES_RU[month]} {year}"
        header_row = " ".join(day_names)

        lines = [header, header_row]

        for week in weeks:
            cells = []
            today_in_row: Optional[int] = None
            for col, d in enumerate(week):
                if d == 0:
                    cells.append("  ")
                else:
                    cells.append(f"{d:2d}")
                    if is_today_month and today.day == d:
                        today_in_row = col

            row = " ".join(cells)

            if today_in_row is not None:
                row += f"  ← {week[today_in_row]}"

            lines.append(row)

        return "\n".join(lines)

    @staticmethod
    def _shift_month(year: int, month: int, delta: int) -> Tuple[int, int]:
        m0 = (month - 1) + delta
        return year + m0 // 12, m0 % 12 + 1

    # ------------------------------------------------------------------ #
    # UI helpers                                                           #
    # ------------------------------------------------------------------ #

    def _notify_event_created(self, event: Event, warn: Optional[str], peer: Any = None):
        text = "Событие создано\n" + self._fmt_event(event)
        if warn:
            text += f"\n{warn}"
        self._bulletin(text, "success", peer=peer)

    def _bulletin(self, text: str, kind: str = "info", peer: Any = None):
        use_bulletin = self.get_setting("confirm_as_bulletin", DEFAULT_CONFIRM_AS_BULLETIN)
        if not use_bulletin:
            if peer is not None:
                self._reply(peer, text)
            else:
                log(f"_bulletin dropped (no peer): {text[:80]}")
            return

        icon = {
            "success": _ICON_SUCCESS,
            "delete": _ICON_DELETE,
        }.get(kind, _ICON_INFO)

        def _show():
            try:
                if icon is not None:
                    BulletinHelper.show_with_button(text, icon, "OK", lambda: None)
                else:
                    BulletinHelper.show_info(text)
            except Exception as e:
                log(f"_bulletin show error: {e}")
                try:
                    BulletinHelper.show_info(text)
                except Exception as e2:
                    log(f"_bulletin show fallback error: {e2}")

        run_on_ui_thread(_show)

    @staticmethod
    def _reply(peer: Any, text: str):
        if peer is not None:
            run_on_queue(lambda: send_message({"peer": peer, "message": text}))

    def _help_text(self) -> str:
        p = self.get_setting("prefix", DEFAULT_PREFIX)
        return (
            "RemindMe Pro — календарь и умные напоминания\n\n"
            f"Быстрый ввод:\n"
            f"  {p} через 15м Попить воды\n"
            f"  {p} завтра в 18:00 Встреча\n"
            f"  {p} 2026-09-01 Учёба\n"
            f"  {p} 2026-09-01 9:00 Учёба\n\n"
            f"Команды:\n"
            f"  {p} add YYYY-MM-DD [H:MM] Текст\n"
            f"  {p} list [N]\n"
            f"  {p} del ID\n"
            f"  {p} month [YYYY-MM]\n"
            f"  {p} next\n"
            f"  {p} clear"
        )

    # ------------------------------------------------------------------ #
    # Dialogs (всё в UI-потоке)                                           #
    # ------------------------------------------------------------------ #

    def _get_activity(self):
        frag = get_last_fragment()
        if not frag:
            return None
        return frag.getParentActivity() or None

    def _open_root_menu(self, peer: Any):
        activity = self._get_activity()
        if not activity:
            BulletinHelper.show_error("Нет активного окна")
            return
        items = [
            "Календарь месяца",
            "Добавить событие",
            "Список ближайших",
            "Ближайшее событие",
            "Справка",
        ]
        actions = [
            lambda: self._show_month_dialog(self._ui_state["year"], self._ui_state["month"]),
            lambda: self._show_add_dialog(peer),
            self._show_list_dialog,
            self._show_next_dialog,
            self._show_help_dialog,
        ]

        bld = AlertDialogBuilder(activity)
        bld.set_title("RemindMe Pro")

        def on_click(b: AlertDialogBuilder, which: int):
            b.dismiss()
            if 0 <= which < len(actions):
                try:
                    actions[which]()
                except Exception as e:
                    log(f"menu action {which} error: {e}")
                    BulletinHelper.show_error(f"Ошибка: {e}")

        bld.set_items(items, on_click)
        bld.set_negative_button("Закрыть", lambda b, _: b.dismiss())
        bld.show()

    def _show_month_dialog(self, year: int, month: int):
        self._ui_state.update(year=year, month=month)
        activity = self._get_activity()
        if not activity:
            return

        # Вычисляем текст один раз до try — fallback использует его же
        try:
            month_text = self._render_month(year, month)
        except Exception as e:
            log(f"_render_month error: {e}")
            month_text = f"⚠️ Ошибка отрисовки: {e}"

        try:
            from android.graphics import Typeface
            from android.view import ViewGroup
            from android.widget import ScrollView, TextView
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme

            sv = ScrollView(activity)
            tv = TextView(activity)
            tv.setText(month_text)
            tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv.setTextSize(15)
            tv.setTypeface(Typeface.MONOSPACE)
            pad = AndroidUtilities.dp(20)
            tv.setPadding(pad, AndroidUtilities.dp(8), pad, AndroidUtilities.dp(8))
            sv.addView(
                tv,
                ViewGroup.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.WRAP_CONTENT,
                ),
            )
            view = sv
        except Exception as e:
            log(f"_show_month_dialog view build error: {e}")
            view = None

        bld = AlertDialogBuilder(activity)
        bld.set_title("Календарь месяца")
        if view is not None:
            bld.set_view(view)
        else:
            bld.set_message("⚠️ Не удалось загрузить графический вид.\n\n" + month_text)

        def go(delta: int, b: AlertDialogBuilder, _):
            b.dismiss()
            y, m = self._shift_month(year, month, delta)
            run_on_ui_thread(lambda: self._show_month_dialog(y, m))

        def go_today(b: AlertDialogBuilder, _):
            b.dismiss()
            now = datetime.today()
            run_on_ui_thread(lambda: self._show_month_dialog(now.year, now.month))

        bld.set_negative_button("◀ Пред", lambda b, w: go(-1, b, w))
        bld.set_neutral_button("Сегодня", go_today)
        bld.set_positive_button("След ▶", lambda b, w: go(+1, b, w))
        bld.show()

    def _show_add_dialog(self, peer: Any):
        activity = self._get_activity()
        if not activity:
            return

        try:
            from android.view import ViewGroup
            from android.widget import EditText, LinearLayout, TextView
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme

            ll = LinearLayout(activity)
            ll.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(16)
            ll.setPadding(pad, pad, pad, pad)

            text_color = Theme.getColor(Theme.key_dialogTextBlack)
            hint_color = Theme.getColor(Theme.key_dialogTextHint)

            def add_field(label: str, hint: str, default: str = "") -> EditText:
                tv = TextView(activity)
                tv.setText(label)
                tv.setTextSize(14)
                tv.setTextColor(text_color)
                ll.addView(tv, ViewGroup.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.WRAP_CONTENT,
                ))
                et = EditText(activity)
                et.setHint(hint)
                et.setTextColor(text_color)
                et.setHintTextColor(hint_color)
                if default:
                    et.setText(default)
                ll.addView(et, ViewGroup.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.WRAP_CONTENT,
                ))
                return et

            today_str = datetime.today().strftime("%Y-%m-%d")
            date_et = add_field("Дата (YYYY-MM-DD)", "Напр.: 2026-08-24", today_str)
            time_et = add_field(
                "Время (H:MM)", "Напр.: 9:00",
                self.get_setting("default_time", DEFAULT_TIME_STR),
            )
            title_et = add_field("Текст события", "Например: Встреча с командой")

            bld = AlertDialogBuilder(activity)
            bld.set_title("Добавить событие")
            bld.set_view(ll)

            def on_ok(b: AlertDialogBuilder, _):
                b.dismiss()
                date_str = date_et.getText().toString().strip()
                time_str = (
                    time_et.getText().toString().strip()
                    or self.get_setting("default_time", DEFAULT_TIME_STR)
                )
                title = title_et.getText().toString().strip()

                def _bg():
                    try:
                        if not title:
                            raise ValueError("Укажите текст события")
                        dt = self._parse_datetime(date_str, time_str)
                        event = self._add_event(dt, title)
                        warn = None
                        if self.get_setting("enable_reminders", DEFAULT_ENABLE_REMINDERS):
                            if not self._schedule_reminder(dt, title, peer or self._get_self_peer()):
                                warn = "Напоминание не запланировано (прошедшее время или ошибка)."
                        self._notify_event_created(event, warn, peer=peer)
                    except Exception as e:
                        # peer из замыкания — иначе ошибка молча съедается
                        self._bulletin(f"Ошибка: {e}", "info", peer=peer)

                run_on_queue(_bg)

            bld.set_positive_button("Создать", on_ok)
            bld.set_negative_button("Отмена", lambda b, _: b.dismiss())
            bld.show()

        except Exception as e:
            log(f"_show_add_dialog build error: {e}")
            BulletinHelper.show_error(f"Не удалось открыть форму: {e}")

    def _show_list_dialog(self):
        activity = self._get_activity()
        if not activity:
            return
        events = self._get_upcoming(10)
        bld = AlertDialogBuilder(activity)
        bld.set_title("Ближайшие события")
        bld.set_message(self._fmt_list(events))
        bld.set_negative_button("Закрыть", lambda b, _: b.dismiss())
        bld.show()

    def _show_next_dialog(self):
        activity = self._get_activity()
        if not activity:
            return
        ev = self._next_event()
        bld = AlertDialogBuilder(activity)
        bld.set_title("Ближайшее событие")
        bld.set_message(self._fmt_event(ev) if ev else "Ближайших событий нет")
        bld.set_negative_button("Закрыть", lambda b, _: b.dismiss())
        bld.show()

    def _show_help_dialog(self):
        activity = self._get_activity()
        if not activity:
            return
        bld = AlertDialogBuilder(activity)
        bld.set_title("Справка")
        bld.set_message(self._help_text())
        bld.set_negative_button("Закрыть", lambda b, _: b.dismiss())
        bld.show()
